# Ports for running both sites locally
PORT_MAIN=3000
PORT_REGISTER=3001

# URLs for production or local development
# In production:
# MAIN_SITE_URL=https://p2p-expert.com
# REGISTER_SITE_URL=https://register.p2p-expert.com
MAIN_SITE_URL=http://localhost:3000
REGISTER_SITE_URL=http://localhost:3001

# Application Name
APP_NAME=p2p

# ===================================================
# GMAIL SMTP CONFIGURATION FOR REAL OTP DELIVERY
# ===================================================
# How to get Gmail App Password:
# 1. Go to Google Account (myaccount.google.com) -> Security
# 2. Turn on 2-Step Verification (if not already enabled)
# 3. Search for "App Passwords"
# 4. Create an App password named "p2p"
# 5. Paste your Gmail and the 16-character code below:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=p2pexpertregistration@gmail.com
SMTP_PASS=bdne kakd pctf csju

